<div id="co2prism-bar" class="co2prism-bar" aria-label="{{localize 'CO2PRISM.Title'}}">
  <div class="co2prism-art" role="img" aria-label="{{localize 'CO2PRISM.NoActor'}}">
    <div class="co2prism-piece co2prism-diamond" style="--x:4;--y:0;--w:524;--h:523"></div>
    <div class="co2prism-piece co2prism-presets" style="--x:0;--y:389;--w:249;--h:126"></div>
    <div class="co2prism-piece co2prism-gauge-base" style="--x:265;--y:261;--w:600;--h:253"></div>
    <img class="co2prism-piece co2prism-portrait" src="icons/svg/mystery-man.svg" alt="" style="--x:93;--y:88;--w:345;--h:346">
    <div aria-hidden="true">
      <span class="co2prism-piece co2prism-number co2prism-number-active" style="--x:102;--y:413;--w:44;--h:44">1</span>
      <span class="co2prism-piece co2prism-number" style="--x:60;--y:462;--w:44;--h:44">2</span>
      <span class="co2prism-piece co2prism-number" style="--x:144;--y:462;--w:44;--h:44">3</span>
      <span class="co2prism-piece co2prism-icon co2prism-icon-muted co2prism-icon-large" style="--x:242;--y:444;--w:48;--h:48"><i class="fa-solid fa-star"></i></span>
      <span class="co2prism-piece co2prism-icon co2prism-icon-muted co2prism-icon-large" style="--x:448;--y:236;--w:48;--h:48"><i class="fa-solid fa-gear"></i></span>
      <div class="co2prism-piece co2prism-gauge co2prism-gauge-orange" data-co2prism-gauge="recovery" style="--x:469;--y:267;--w:190;--h:51"></div>
      <div class="co2prism-piece co2prism-gauge co2prism-gauge-resource" data-co2prism-gauge="fortune" style="--x:403;--y:329;--w:319;--h:52"></div>
      <div class="co2prism-piece co2prism-gauge co2prism-gauge-purple" data-co2prism-gauge="mana" style="--x:341;--y:392;--w:443;--h:51"></div>
      <div class="co2prism-piece co2prism-gauge co2prism-gauge-health" data-co2prism-gauge="hp" style="--x:278;--y:454;--w:569;--h:52"></div>
      <span class="co2prism-piece co2prism-icon" style="--x:502;--y:274;--w:40;--h:40"><i class="fa-solid fa-heart-pulse"></i></span>
      <span class="co2prism-piece co2prism-icon" style="--x:502;--y:337;--w:40;--h:40"><i class="fa-solid fa-clover"></i></span>
      <span class="co2prism-piece co2prism-icon" style="--x:486;--y:398;--w:40;--h:40"><i class="fa-solid fa-bolt"></i></span>
      <span class="co2prism-piece co2prism-icon" style="--x:485;--y:461;--w:40;--h:40"><i class="fa-solid fa-heart"></i></span>
      <span class="co2prism-piece co2prism-icon co2prism-icon-dark" style="--x:700;--y:460;--w:40;--h:40"><i class="fa-solid fa-mug-saucer"></i></span>
      <span class="co2prism-piece co2prism-icon co2prism-icon-dark" style="--x:758;--y:460;--w:42;--h:40"><i class="fa-solid fa-bed"></i></span>
      <span class="co2prism-piece co2prism-value" data-co2prism-value="recovery" style="--x:542;--y:267;--w:80;--h:51">{{localize 'CO2PRISM.Unavailable'}}</span>
      <span class="co2prism-piece co2prism-value" data-co2prism-value="fortune" style="--x:540;--y:329;--w:80;--h:52">{{localize 'CO2PRISM.Unavailable'}}</span>
      <span class="co2prism-piece co2prism-value" data-co2prism-value="mana" style="--x:530;--y:392;--w:100;--h:51">{{localize 'CO2PRISM.Unavailable'}}</span>
      <span class="co2prism-piece co2prism-value" data-co2prism-value="hp" style="--x:532;--y:454;--w:100;--h:52">{{localize 'CO2PRISM.Unavailable'}}</span>
    </div>
  </div>
  <div class="co2prism-tools">
    <button type="button" class="co2prism-handle" title="{{localize 'CO2PRISM.Move'}}" aria-label="{{localize 'CO2PRISM.Move'}}"><i class="fa-solid fa-arrows-up-down-left-right" aria-hidden="true"></i></button>
    <button type="button" class="co2prism-lock"></button>
  </div>
</div>
