<div id="co2prism-bar" class="co2prism-bar" data-tooltip-class="co2prism-tooltip" aria-label="{{localize 'CO2PRISM.Title'}}">
  <div class="co2prism-art" role="group" aria-label="{{localize 'CO2PRISM.NoActor'}}">
    {{{inventory}}}
    {{{movement}}}
    {{{skills}}}
    {{{core}}}
    {{{effects}}}
    {{{combat}}}
    {{{combatActions}}}
    <div popover="manual" class="co2prism-shortcut-preview"></div>
  </div>
  <div popover="auto" class="co2prism-equipment-menu" role="group" aria-label="{{localize 'CO2PRISM.Equipment.Operations.Title'}}"></div>
  <div popover="auto" class="co2prism-preset-action-menu" role="group" aria-label="{{localize 'CO2PRISM.PresetAction.Title'}}"></div>
</div>
